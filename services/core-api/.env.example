# Supabase → Project Settings → Database → Connection string → "Direct connection" (พอร์ต 5432)
# ใช้ตัวนี้สำหรับ migration เท่านั้น
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ตอนแอปรันจริงให้ใช้ pooler (พอร์ต 6543) — ทนคอนเนกชันเยอะกว่า
DATABASE_POOL_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
