{
  "name": "@wingdai/core-api",
  "version": "0.1.0",
  "private": true,
  "description": "Wingdai core API — auth, catalog, order, payment, ledger, notification",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx src/db/setup.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:demo-orders": "tsx scripts/seedDemoOrders.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "api:smoke": "tsx src/api.smoke.ts",
    "storage:setup": "tsx scripts/setupStorage.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.9",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
